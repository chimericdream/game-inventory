DATABASE_URL=postgres://games:games@localhost:5432/games

# Production compose (docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me
# APP_PORT=3000
# COOKIE_SECURE=false

# Optional
# Days a deleted item waits in the trash before it is deleted for good (0 = never)
# TRASH_RETENTION_DAYS=30
# DATA_DIR=./data
# AUTO_MIGRATE=true
# BoardGameGeek lookup token (register an app at boardgamegeek.com)
# BGG_API_TOKEN=

# End-to-end tests only (point lookups at the mock server; leave unset in real use)
# BGG_BASE_URL=
# BGG_IMAGE_ORIGIN=
# UPC_BASE_URL=
# E2E_DATABASE_URL=postgres://games:games@localhost:5432/games_e2e
