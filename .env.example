DATABASE_URL=postgres://games:games@localhost:5432/games

# Production compose (docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me
# APP_PORT=3000
# COOKIE_SECURE=false

# Optional
# Days a deleted item waits in the trash before it is deleted for good (0 = never)
# TRASH_RETENTION_DAYS=30
# DATA_DIR=./data
# Largest file you can attach to a print & play copy, in MB (default 250)
# MAX_FILE_MB=250
# Overrides the version reported by GET /healthz (defaults to the version in package.json)
# APP_VERSION=
# AUTO_MIGRATE=true
# Extra hostnames that may submit server actions (e.g. behind a reverse proxy), comma-separated.
# Applied when the container starts (scripts/start-standalone.mjs) and read by next.config.ts for dev.
# ALLOWED_ORIGINS=games.example.com,games.example.ts.net
# BoardGameGeek lookup token (register an app at boardgamegeek.com)
# BGG_API_TOKEN=

# End-to-end tests only (point lookups at the mock server; leave unset in real use)
# BGG_BASE_URL=
# BGG_IMAGE_ORIGIN=
# UPC_BASE_URL=
# E2E_DATABASE_URL=postgres://games:games@localhost:5432/games_e2e
